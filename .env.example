# ─────────────────────────────────────────
# SCRAPER
# ─────────────────────────────────────────
SEED_URLS=https://mospi.gov.in/web/mospi/press-releases,https://mospi.gov.in/web/mospi/reports
MAX_PAGES_PER_RUN=5
CONCURRENCY=2
RATE_LIMIT_DELAY=1.5
USER_AGENT=MoSPI-Research-Bot/1.0 (academic-research; contact@example.com)
RESPECT_ROBOTS_TXT=true

# ─────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────
DB_PATH=data/mospi.db
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ─────────────────────────────────────────
# ETL
# ─────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ─────────────────────────────────────────
# RAG / EMBEDDINGS
# ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=data/processed/vector_store
TOP_K=5
TEMPERATURE=0.1

# ─────────────────────────────────────────
# LLM — Ollama (local)
# ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─────────────────────────────────────────
# API
# ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─────────────────────────────────────────
# UI
# ─────────────────────────────────────────
UI_PORT=8501
API_URL=http://localhost:8000

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json