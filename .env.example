# ─────────────────────────────────────────
# SCRAPER
# ─────────────────────────────────────────
# mospi.gov.in is a client-rendered SPA: every path returns the same HTML
# shell, so there is nothing to crawl as HTML. The scraper calls the site's
# own public JSON API instead.
MOSPI_API_BASE=https://www.mospi.gov.in/api
# Listings to pull: latest-release (press notes), publications-reports (reports)
SOURCES=latest-release,publications-reports
API_PAGE_SIZE=50
API_LANG=en

# Max API listing pages per source, per run. 50 x 5 = up to 250 docs per source.
MAX_PAGES_PER_RUN=5

# Unused; kept so older .env files keep loading.
SEED_URLS=https://mospi.gov.in/web/mospi/press-releases,https://mospi.gov.in/web/mospi/reports
CONCURRENCY=2
RATE_LIMIT_DELAY=1.5
USER_AGENT=MoSPI-Research-Bot/1.0 (academic-research; contact@example.com)
RESPECT_ROBOTS_TXT=true

# ─────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────
DB_PATH=data/mospi.db
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ─────────────────────────────────────────
# ETL
# ─────────────────────────────────────────
# Measured in WORDS. 180 words is about 240 word-pieces, which stays under
# all-MiniLM-L6-v2's 256-token limit; larger chunks are silently truncated.
CHUNK_SIZE=180
CHUNK_OVERLAP=40
MIN_CHUNK_WORDS=20

# Max tables STORED per PDF. Keep this high: storing a parsed table is cheap,
# and a low cap silently truncates a document part-way through. At 25, the
# October CPI press note stopped one page before its state-wise table, so
# cpi_state simply had no October rows -- no error, no warning.
MAX_TABLES_PER_PDF=300

# The expensive step is per-page table DETECTION, which is roughly quadratic
# in the number of ruling lines on a page. One 25 MB yearbook burned over 9
# minutes of CPU. Text extraction is cheap and still covers EVERY page; only
# table extraction is capped by page count here.
MAX_TABLE_PAGES=40

# Skip downloading files larger than this. The monthly press notes carrying
# the CPI/IIP/GDP series are 300-600 KB.
MAX_PDF_MB=20

# ─────────────────────────────────────────
# RAG / EMBEDDINGS
# ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=data/processed/vector_store
TOP_K=5
TEMPERATURE=0.1

# ─────────────────────────────────────────
# LLM
# ─────────────────────────────────────────
# Which provider the agents use: gemini | ollama
LLM_PROVIDER=gemini

# Gemini (Google AI Studio free tier -- no card required).
# Get a key at https://aistudio.google.com/apikey
#
# PUT YOUR REAL KEY IN .env, NEVER HERE.
# .env is gitignored (.gitignore:25); .env.example is committed, so anything
# written below this line becomes public the moment you push.
GEMINI_API_KEY=

# Model IDs move fast: gemini-2.0-flash is already retired, and the whole
# family shifted to 3.x during 2026. Google no longer publishes per-model
# free-tier limits -- check YOUR project at aistudio.google.com/rate-limit,
# or run `make models` to list what this key can actually reach.
#
# Two models on purpose. The newest Flash is reported at only ~20 requests
# per DAY on the free tier, which is unusable for a 45-question eval suite,
# while Flash-Lite allows ~500. So: quality where reasoning decides the
# outcome, volume where it does not.
GEMINI_MODEL=
GEMINI_MODEL_CHEAP=

# Nodes that use GEMINI_MODEL_CHEAP. The supervisor and critic emit short
# structured verdicts; on a reasoning model they measured 36s and 22s each,
# almost all of it thinking tokens spent on a one-line classification.
LLM_CHEAP_NODES=supervisor,critic

# Hard ceiling on API calls per process run. Raises instead of silently
# burning the daily quota. The agent graph makes 4-6 calls per question.
LLM_MAX_REQUESTS_PER_RUN=30

# Cache responses on disk, keyed by hash(model, prompt, temperature).
# Re-asking the same question then costs 0 requests, which is what makes the
# eval suite re-runnable against a 500/day limit.
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=data/processed/llm_cache

# Ollama (local fallback; needs `ollama serve` + `ollama pull llama3`).
# Use localhost when running outside Docker, `ollama` as the host inside it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─────────────────────────────────────────
# API
# ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─────────────────────────────────────────
# UI
# ─────────────────────────────────────────
UI_PORT=8501
API_URL=http://api:8000

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json