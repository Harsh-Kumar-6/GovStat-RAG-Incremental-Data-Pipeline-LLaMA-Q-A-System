# ─────────────────────────────────────────
# SCRAPER
# ─────────────────────────────────────────
# mospi.gov.in is a client-rendered SPA: every path returns the same HTML
# shell, so there is nothing to crawl as HTML. The scraper calls the site's
# own public JSON API instead.
MOSPI_API_BASE=https://www.mospi.gov.in/api
# Listings to pull: latest-release (press notes), publications-reports (reports)
SOURCES=latest-release,publications-reports
API_PAGE_SIZE=50
API_LANG=en

# Max API listing pages per source, per run. 50 x 5 = up to 250 docs per source.
MAX_PAGES_PER_RUN=5

# Unused; kept so older .env files keep loading.
SEED_URLS=https://mospi.gov.in/web/mospi/press-releases,https://mospi.gov.in/web/mospi/reports
CONCURRENCY=2
RATE_LIMIT_DELAY=1.5
USER_AGENT=MoSPI-Research-Bot/1.0 (academic-research; contact@example.com)
RESPECT_ROBOTS_TXT=true

# ─────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────
DB_PATH=data/mospi.db
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ─────────────────────────────────────────
# ETL
# ─────────────────────────────────────────
# Measured in WORDS. 180 words is about 240 word-pieces, which stays under
# all-MiniLM-L6-v2's 256-token limit; larger chunks are silently truncated.
CHUNK_SIZE=180
CHUNK_OVERLAP=40
MIN_CHUNK_WORDS=20

# Max tables extracted and stored per PDF.
MAX_TABLES_PER_PDF=25

# ─────────────────────────────────────────
# RAG / EMBEDDINGS
# ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=data/processed/vector_store
TOP_K=5
TEMPERATURE=0.1

# ─────────────────────────────────────────
# LLM — Ollama (local)
# ─────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ─────────────────────────────────────────
# API
# ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─────────────────────────────────────────
# UI
# ─────────────────────────────────────────
UI_PORT=8501
API_URL=http://api:8000

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json